<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.EstudiantesController">
    <top>
        <VBox spacing="10" styleClass="panel-formulario">
            <padding><Insets top="15" right="15" bottom="10" left="15"/></padding>
            <Label text="Registrar estudiante" styleClass="titulo-seccion"/>
            <GridPane hgap="10" vgap="8">
                <columnConstraints/>
                <Label text="Nombre completo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="220"/>

                <Label text="Documento de identidad:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="txtDocumento" GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="150"/>

                <Label text="Telefono:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtTelefono" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="220"/>

                <Label text="Correo electronico:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <TextField fx:id="txtCorreo" GridPane.rowIndex="1" GridPane.columnIndex="3" prefWidth="220"/>

                <Label text="Edad:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtEdad" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="80"/>
            </GridPane>
            <HBox spacing="10">
                <Button text="Registrar" onAction="#onRegistrar" defaultButton="true"/>
                <Button text="Limpiar" onAction="#onLimpiar"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <padding><Insets top="10" right="15" bottom="15" left="15"/></padding>
            <Label text="Estudiantes registrados" styleClass="titulo-seccion"/>
            <TableView fx:id="tablaEstudiantes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
                    <TableColumn fx:id="colDocumento" text="Documento" prefWidth="120"/>
                    <TableColumn fx:id="colTelefono" text="Telefono" prefWidth="110"/>
                    <TableColumn fx:id="colCorreo" text="Correo" prefWidth="200"/>
                    <TableColumn fx:id="colEdad" text="Edad" prefWidth="60"/>
                    <TableColumn fx:id="colFechaRegistro" text="Fecha registro" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
