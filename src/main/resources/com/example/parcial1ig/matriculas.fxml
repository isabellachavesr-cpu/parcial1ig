<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.MatriculasController">
    <top>
        <VBox spacing="10" styleClass="panel-formulario">
            <padding><Insets top="15" right="15" bottom="10" left="15"/></padding>
            <Label text="Matricular estudiante" styleClass="titulo-seccion"/>
            <GridPane hgap="10" vgap="8">
                <Label text="Estudiante:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboEstudiante" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="260"/>

                <Label text="Curso:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <ComboBox fx:id="comboCurso" GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="260"/>

                <Label text="Descuento (%):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDescuento" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="80"/>
            </GridPane>

            <Label text="Servicios adicionales (seleccion multiple):"/>
            <ListView fx:id="listaServicios" prefHeight="90"/>

            <VBox fx:id="panelProfesor" spacing="6">
                <Label text="Profesor asignado (curso personalizado):"/>
                <ComboBox fx:id="comboProfesor" prefWidth="260"/>
            </VBox>

            <HBox spacing="10">
                <Button text="Matricular" onAction="#onMatricular" defaultButton="true"/>
            </HBox>
            <Label fx:id="lblValorEstimado" styleClass="valor-destacado"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <padding><Insets top="10" right="15" bottom="15" left="15"/></padding>
            <Label text="Matriculas registradas" styleClass="titulo-seccion"/>
            <TableView fx:id="tablaMatriculas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="#" prefWidth="40"/>
                    <TableColumn fx:id="colEstudiante" text="Estudiante" prefWidth="180"/>
                    <TableColumn fx:id="colCurso" text="Curso" prefWidth="160"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                    <TableColumn fx:id="colServicios" text="Servicios" prefWidth="110"/>
                    <TableColumn fx:id="colDescuento" text="Descuento" prefWidth="90"/>
                    <TableColumn fx:id="colValorFinal" text="Valor final" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
