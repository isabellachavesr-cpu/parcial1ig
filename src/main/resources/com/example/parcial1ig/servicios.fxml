<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ServiciosController">
    <top>
        <VBox spacing="10" styleClass="panel-formulario">
            <padding><Insets top="15" right="15" bottom="10" left="15"/></padding>
            <Label text="Registrar servicio adicional" styleClass="titulo-seccion"/>
            <GridPane hgap="10" vgap="8">
                <Label text="Codigo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCodigo" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="100"/>

                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="200"/>

                <Label text="Descripcion:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDescripcion" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300" GridPane.columnSpan="3"/>

                <Label text="Precio:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtPrecio" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="100"/>

                <Label text="Disponible:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                <CheckBox fx:id="chkDisponible" selected="true" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
            </GridPane>
            <HBox spacing="10">
                <Button text="Registrar" onAction="#onRegistrar" defaultButton="true"/>
                <Button text="Limpiar" onAction="#onLimpiar"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <padding><Insets top="10" right="15" bottom="15" left="15"/></padding>
            <Label text="Servicios adicionales registrados" styleClass="titulo-seccion"/>
            <TableView fx:id="tablaServicios" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Codigo" prefWidth="80"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
                    <TableColumn fx:id="colDescripcion" text="Descripcion" prefWidth="260"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="90"/>
                    <TableColumn fx:id="colDisponible" text="Disponible" prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
